{
  "name": "pcb-fps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/main.ts\" \"vite --host 0.0.0.0\"",
    "dev:scale": "concurrently -k \"tsx watch tools/dev-scale-server.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build && esbuild server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/main.js",
    "start": "node dist-server/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "tsx tools/browser-check.ts",
    "test:backside": "tsx tools/backside-browser.ts",
    "test:movement": "tsx tools/movement-suite.ts",
    "test:soak": "tsx tools/soak-gameplay.ts",
    "import:step": "tsx tools/import-step.ts",
    "audit:map": "tsx tools/audit-map.ts",
    "import:practice-map": "tsx tools/import-practice-map.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.0",
    "@colyseus/sdk": "^0.18.0",
    "colyseus": "^0.18.0",
    "express": "^5.0.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.181.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "occt-import-js": "^0.0.23",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
